DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-plus
# Set the compatible API address for your own Bailian workspace and region.
QWEN_VISION_BASE_URL=

# Navigation AI is configured independently by the navigation teammate.
# Blank values DISABLE AI navigation; vision credentials are never reused.
NAV_AI_API_KEY=
NAV_AI_MODEL=
NAV_AI_BASE_URL=

# Speech input for AI navigation, independent of the two blocks above.
# Blank values fall back to the browser's own speech recognition.
NAV_ASR_API_KEY=
NAV_ASR_MODEL=qwen3-asr-flash
NAV_ASR_BASE_URL=
